# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origin (CORS frontend URL)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/aptivella

# Authentication
JWT_SECRET=your_secure_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Razorpay Test Mode Configuration (Never use live keys)
# Obtain genuine test credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Enable developer payment simulation for offline/test environments only (Disabled in production)
ENABLE_TEST_PAYMENT_SIMULATION=true


